{
  "name": "power-framework",
  "version": "1.0.0",
  "description": "P.O.W.E.R. - Progressively Optimized Web Engine for Rendering. Zero-dependency Node.js framework.",
  "type": "module",
  "main": "app.js",
  "bin": {
    "power": "bin/power-cli.js"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning app.js",
    "dev": "node bin/power-cli.js serve",
