# ==============================================================================
# P.O.W.E.R. — safe environment template for Git
# Copy this file to .env and edit the values for your machine/deployment.
# Do NOT put real passwords, production secrets, or private database URLs here.
#
# Keep only ONE DB_URL line active. SQLite is the active default.
# URL-encode special characters in DB usernames/passwords: @ -> %40, : -> %3A,
# / -> %2F, # -> %23.
# ==============================================================================

# --- App and server -----------------------------------------------------------
NODE_ENV=development
APP_NAME="P.O.W.E.R."
HOST=127.0.0.1
PORT=3000

# --- Security and authentication ---------------------------------------------
# Leave SESSION_SECRET blank for local development; production requires >=32 chars.
# Generate a secret with: node bin/power-cli.js key:generate
SESSION_SECRET=
PASSWORD_PEPPER=
POWER_ADMIN_EMAIL=admin@power.local
POWER_ADMIN_PASSWORD=

# --- Database: choose ONE DB_URL ----------------------------------------------
# Active default: local SQLite database file.
DB_URL=sqlite:storage/power.sqlite

# XAMPP MySQL/MariaDB with local root and no password:
# DB_URL=mysql://root:@127.0.0.1:3306/power
#   root = username; empty password is the empty part after root:
#   127.0.0.1 = database server; 3306 = port; power = database name

# MySQL with credentials:
# DB_URL=mysql://<USERNAME>:<URL_ENCODED_PASSWORD>@127.0.0.1:3306/<DATABASE_NAME>

# MariaDB:
# DB_URL=mariadb://<USERNAME>:<URL_ENCODED_PASSWORD>@127.0.0.1:3306/<DATABASE_NAME>

# PostgreSQL (postgres and postgresql are both accepted):
# DB_URL=postgres://<USERNAME>:<URL_ENCODED_PASSWORD>@127.0.0.1:5432/<DATABASE_NAME>
# DB_URL=postgresql://<USERNAME>:<URL_ENCODED_PASSWORD>@127.0.0.1:5432/<DATABASE_NAME>

# Hosted/remote PostgreSQL with TLS:
# DB_URL=postgres://<USERNAME>:<URL_ENCODED_PASSWORD>@<DB_HOST>:5432/<DATABASE_NAME>?sslmode=verify-full
# If your provider only requires encryption and doesn't support certificate verification:
# DB_URL=postgres://<USERNAME>:<URL_ENCODED_PASSWORD>@<DB_HOST>:5432/<DATABASE_NAME>?sslmode=require

# Hosted/remote MySQL with TLS required:
# DB_URL=mysql://<USERNAME>:<URL_ENCODED_PASSWORD>@<DB_HOST>:3306/<DATABASE_NAME>?ssl=true

# Optional URL parameters: pool=5, timeout=30000, ssl=true,
# sslmode=disable|require|verify-ca|verify-full, sslca=/path/to/ca.pem
DB_PATH=storage/power.sqlite
DB_POOL_MAX=5

# Additional named databases (optional; don't replace DB_URL):
# DB_ANALYTICS_URL=postgres://<USERNAME>:<URL_ENCODED_PASSWORD>@<DB_HOST>:5432/analytics?sslmode=verify-full
# DB_REPORTING_URL=mysql://<USERNAME>:<URL_ENCODED_PASSWORD>@<DB_HOST>:3306/reporting?ssl=true

# --- Sessions -----------------------------------------------------------------
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_HOURS=72

# --- Request/server limits ----------------------------------------------------
BODY_LIMIT=1048576
TRUST_PROXY=false
MAX_CONNECTIONS=1000
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT=20

# --- Site behavior and security -----------------------------------------------
ALLOW_REGISTRATION=true
LIVE_RELOAD=true
ALLOWED_HOSTS=
FORCE_HTTPS=false
TLS_CERT=
TLS_KEY=
REQUIRE_ADMIN_2FA=false

# --- Presentation limits ------------------------------------------------------
PRESENTATION_MAX_SLIDES=200
PRESENTATION_MAX_KB=200
PRESENTATION_MAX_VIEWERS=2000
PRESENTATION_MAX_CONN_PER_IP=10

# --- Public template variables (never put secrets here) -----------------------
# PUBLIC_ANALYTICS_ID=your-public-analytics-id

# --- Secret files (optional) --------------------------------------------------
# SESSION_SECRET_FILE=/run/secrets/session_secret
# DB_URL_FILE=/run/secrets/database_url
# POWER_ADMIN_PASSWORD_FILE=/run/secrets/power_admin_password
